# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Wallet auth (sign-message login)
REQUIRE_WALLET_AUTH=true
AUTH_TOKEN_SECRET=change-me
AUTH_TOKEN_TTL_SEC=86400
AUTH_CHALLENGE_TTL_SEC=300

# Agent safety
AGENT_DRY_RUN=true
MAX_TX_SIZE_SOL=2
MAX_HIGH_RISK_TX_SIZE_SOL=0.5
MAX_DAILY_LOSS_PCT=8
NFT_CONFIRMATION_THRESHOLD_SOL=3
DEFAULT_RISK_TOLERANCE=medium
ALLOWED_PROTOCOLS=jupiter,marinade,raydium
BLOCKED_PROTOCOLS=
SCHEDULER_DEFAULT_INTERVAL_SEC=300

# LLM provider (OpenAI-compatible)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
OPENAI_API_KEY=

# Optional Pinecone memory
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=wallet-agent

# Optional static prices for portfolio valuation
# TOKEN_PRICES_JSON={"SOL":180,"USDC":1,"MSOL":183,"RAY":2.1}

# Price source: binance | coinmarketcap
PRICE_PROVIDER=binance
PRICE_CACHE_TTL_SECONDS=30
COINMARKETCAP_API_KEY=
MARKET_SIGNAL_CACHE_TTL_SECONDS=45
# Optional risk feed controls
# FLAGGED_PROTOCOLS=raydium
# PROTOCOL_RISK_PENALTIES_JSON={"raydium":12}

# Real Jupiter execution wallet (server-side delegated key)
JUPITER_SLIPPAGE_BPS=50
# JUPITER_EXECUTION_WALLET_PRIVATE_KEY=<base58-secret-or-json-array>
